rules_version = '2';

// Assumed private data model:
// - idoso_perfil/idosos: elderly PII plus server-controlled caregiver network.
// - supervisores: caregiver PII; only the owner or a linked elderly user reads it.
// - lembretes, lembrete_eventos, mensagens, video_calls, alertas
//   and estoque_movimentos: scoped by idosoId.
// - device_diagnostics and health_metrics: keyed by elderly UID.
// - alert writes, stock movements, pairing codes/state, rate limits and barcode
//   reference data are server-only.
// Relationship authority is never accepted from client writes.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function hasCanonicalProfile(elderlyId) {
      return exists(
        /databases/$(database)/documents/idoso_perfil/$(elderlyId)
      );
    }

    function canonicalProfile(elderlyId) {
      return get(
        /databases/$(database)/documents/idoso_perfil/$(elderlyId)
      ).data;
    }

    function profileHasCaregiver(data, caregiverId) {
      return data.get('supervisorId', null) == caregiverId ||
        caregiverId in data.get('caregiverIds', []);
    }

    function profileCanManage(data, caregiverId) {
      return data.get('supervisorId', null) == caregiverId ||
        data.get(['caregiverRoles', caregiverId], '') in [
          'primary',
          'backup',
          'family'
        ];
    }

    function isLinkedSupervisor(elderlyId) {
      let profile = canonicalProfile(elderlyId);
      return profile.status == 'active' &&
        profileHasCaregiver(profile, request.auth.uid);
    }

    function isManagingSupervisor(elderlyId) {
      let profile = canonicalProfile(elderlyId);
      return profile.status == 'active' &&
        profileCanManage(profile, request.auth.uid);
    }

    function isLinkedElderly(supervisorId) {
      let profile = canonicalProfile(request.auth.uid);
      return profile.status == 'active' &&
        profileHasCaregiver(profile, supervisorId);
    }

    function canAccessElderly(elderlyId) {
      return isOwner(elderlyId) || isLinkedSupervisor(elderlyId);
    }

    function canManageElderly(elderlyId) {
      return isOwner(elderlyId) || isManagingSupervisor(elderlyId);
    }

    function requestHasElderlyId() {
      return request.resource != null &&
        request.resource.data.keys().hasAll(['idosoId']);
    }

    function resourceHasElderlyId() {
      return resource != null &&
        resource.data.keys().hasAll(['idosoId']);
    }

    function isNonEmptyString(value, maxLength) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= maxLength;
    }

    function isOptionalString(data, field, maxLength) {
      let value = data.get(field, null);
      return value == null ||
        (value is string && value.size() <= maxLength);
    }

    function isOptionalNonEmptyString(data, field, maxLength) {
      let value = data.get(field, null);
      return value == null || isNonEmptyString(value, maxLength);
    }

    function isOptionalInt(data, field, minValue, maxValue) {
      let value = data.get(field, null);
      return value == null ||
        (value is int && value >= minValue && value <= maxValue);
    }

    function isOptionalNumber(data, field, minValue, maxValue) {
      let value = data.get(field, null);
      return value == null ||
        (value is number && value >= minValue && value <= maxValue);
    }

    function isOptionalBool(data, field) {
      let value = data.get(field, null);
      return value == null || value is bool;
    }

    function isDate(value) {
      return value is timestamp ||
        (
          value is string &&
          value.size() >= 10 &&
          value.size() <= 40 &&
          value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}.*$')
        );
    }

    function isOptionalDate(data, field) {
      let value = data.get(field, null);
      return value == null || isDate(value);
    }

    function validReminderStatus(value) {
      return value in [
        'pendente',
        'concluido',
        'concluido_com_foto',
        'adiado',
        'perdido',
        'precisa_de_ajuda',
        'confirmado_pelo_cuidador'
      ];
    }

    function validCategory(value) {
      return value in [
        'medicacao',
        'refeicoes',
        'exercicio',
        'hidratacao',
        'consulta',
        'personalizado'
      ];
    }

    function isOptString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isOptInt(val, minV, maxV) {
      return val == null || (val is int && val >= minV && val <= maxV);
    }

    function isOptNum(val, minV, maxV) {
      return val == null || (val is number && val >= minV && val <= maxV);
    }

    function isOptBool(val) {
      return val == null || val is bool;
    }

    function isOptDate(val) {
      return val == null || isDate(val);
    }

    function validReminderCore(data) {
      let st = data.status;
      return data.keys().hasOnly([
        'id',
        'titulo',
        'horarioHour',
        'horarioMinute',
        'originalHorarioHour',
        'originalHorarioMinute',
        'categoria',
        'audioPath',
        'concluido',
        'concluidoComFoto',
        'criadoEm',
        'medicamentoFotoPath',
        'idosoId',
        'status',
        'repeteTodosOsDias',
        'recorrenciaSemanal',
        'recorrenciaMensal',
        'recorrenciaIntervalo',
        'lembreteUnico',
        'diasSemana',
        'diaMes',
        'intervaloHoras',
        'recorrencia',
        'dataInicio',
        'dataFim',
        'isUsoContinuo',
        'medicamentoInstrucoes',
        'medicamentoAudioTexto',
        'prioridade',
        'toleranciaMinutos',
        'intervaloRepeticaoMinutos',
        'maximoRepeticoes',
        'avisarCuidador',
        'medicamentoDose',
        'medicamentoUnidade',
        'medicamentoEstoque',
        'medicamentoEstoqueMinimo',
        'medicamentoUnidadesPorDose',
        'medicamentoFormato',
        'medicamentoCor',
        'modoConfirmacao',
        'opcoesAdiamentoMinutos',
        'maximoAdiamentos',
        'arquivado',
        'arquivadoEm'
      ]) &&
      data.keys().hasAll(['id', 'titulo', 'horarioHour', 'horarioMinute', 'categoria', 'idosoId', 'status', 'concluido', 'criadoEm']) &&
      isNonEmptyString(data.id, 128) &&
      isNonEmptyString(data.titulo, 200) &&
      data.horarioHour is int && data.horarioHour >= 0 && data.horarioHour <= 23 &&
      data.horarioMinute is int && data.horarioMinute >= 0 && data.horarioMinute <= 59 &&
      isNonEmptyString(data.idosoId, 128) &&
      data.categoria in ['medicacao', 'refeicoes', 'exercicio', 'hidratacao', 'consulta', 'personalizado'] &&
      st in ['pendente', 'concluido', 'concluido_com_foto', 'adiado', 'perdido', 'precisa_de_ajuda', 'confirmado_pelo_cuidador'] &&
      data.concluido is bool &&
      data.concluidoComFoto is bool &&
      isDate(data.criadoEm) &&
      data.concluido == (st in ['concluido', 'concluido_com_foto', 'confirmado_pelo_cuidador']) &&
      data.concluidoComFoto == (st == 'concluido_com_foto');
    }

    function validReminderConfig(data) {
      let mode = data.get('modoConfirmacao', 'simples');
      let snooze = data.get('opcoesAdiamentoMinutos', [5, 10, 15]);
      let foto = data.get('medicamentoFotoPath', null);
      let st = data.status;
      return (data.get('prioridade', 'normal') in ['normal', 'importante', 'critica']) &&
        (mode in ['simples', 'voz_ou_botao', 'foto', 'cuidador']) &&
        (snooze is list && snooze.size() >= 1 && snooze.size() <= 4 && snooze.hasOnly([5, 10, 15, 30])) &&
        isOptInt(data.get('toleranciaMinutos', null), 1, 1440) &&
        isOptInt(data.get('intervaloRepeticaoMinutos', null), 1, 120) &&
        isOptInt(data.get('maximoRepeticoes', null), 0, 10) &&
        isOptInt(data.get('maximoAdiamentos', null), 0, 5) &&
        isOptBool(data.get('avisarCuidador', null)) &&
        (
          mode != 'foto' ||
          !data.concluido ||
          (
            st == 'concluido_com_foto' &&
            foto is string &&
            foto.size() <= 2048 &&
            foto.matches('^https://.*$')
          )
        ) &&
        (
          mode != 'cuidador' ||
          !data.concluido ||
          st == 'confirmado_pelo_cuidador'
        );
    }

    function validReminderSchedule(data) {
      let dias = data.get('diasSemana', null);
      return (
          dias == null ||
          (dias is list && dias.size() <= 7 && dias.hasOnly([1, 2, 3, 4, 5, 6, 7]))
        ) &&
        isOptDate(data.get('dataInicio', null)) &&
        isOptDate(data.get('dataFim', null)) &&
        isOptInt(data.get('originalHorarioHour', null), 0, 23) &&
        isOptInt(data.get('originalHorarioMinute', null), 0, 59) &&
        isOptString(data.get('recorrencia', null), 30) &&
        isOptInt(data.get('diaMes', null), 1, 31) &&
        isOptInt(data.get('intervaloHoras', null), 1, 24) &&
        isOptBool(data.get('repeteTodosOsDias', null)) &&
        isOptBool(data.get('recorrenciaSemanal', null)) &&
        isOptBool(data.get('recorrenciaMensal', null)) &&
        isOptBool(data.get('recorrenciaIntervalo', null)) &&
        isOptBool(data.get('lembreteUnico', null)) &&
        isOptBool(data.get('isUsoContinuo', null));
    }

    function validReminderMedication(data) {
      return isOptString(data.get('medicamentoDose', null), 40) &&
        isOptString(data.get('medicamentoUnidade', null), 30) &&
        isOptInt(data.get('medicamentoEstoque', null), 0, 1000000) &&
        isOptInt(data.get('medicamentoEstoqueMinimo', null), 0, 1000000) &&
        isOptNum(data.get('medicamentoUnidadesPorDose', null), 0.01, 10000) &&
        isOptString(data.get('medicamentoInstrucoes', null), 1000) &&
        isOptString(data.get('medicamentoAudioTexto', null), 1000) &&
        isOptString(data.get('audioPath', null), 2048) &&
        isOptString(data.get('medicamentoFotoPath', null), 2048) &&
        isOptString(data.get('medicamentoFormato', null), 50) &&
        isOptString(data.get('medicamentoCor', null), 50);
    }

    function validReminderArchive(data) {
      let archived = data.get('arquivado', false);
      let archivedAt = data.get('arquivadoEm', null);
      return archived is bool &&
        isOptDate(archivedAt) &&
        (!archived || isDate(archivedAt));
    }

    function validReminder(data) {
      return validReminderCore(data) &&
        validReminderConfig(data) &&
        validReminderSchedule(data) &&
        validReminderMedication(data) &&
        validReminderArchive(data);
    }

    function validReminderUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let st = data.status;
      let mode = data.get('modoConfirmacao', 'simples');
      let currentMode = resource.data.get('modoConfirmacao', 'simples');
      return resource != null &&
        resource.data != null &&
        data.keys().hasOnly([
          'id',
          'titulo',
          'horarioHour',
          'horarioMinute',
          'originalHorarioHour',
          'originalHorarioMinute',
          'categoria',
          'audioPath',
          'concluido',
          'concluidoComFoto',
          'criadoEm',
          'medicamentoFotoPath',
          'idosoId',
          'status',
          'repeteTodosOsDias',
          'recorrenciaSemanal',
          'recorrenciaMensal',
          'recorrenciaIntervalo',
          'lembreteUnico',
          'diasSemana',
          'diaMes',
          'intervaloHoras',
          'recorrencia',
          'dataInicio',
          'dataFim',
          'isUsoContinuo',
          'medicamentoInstrucoes',
          'medicamentoAudioTexto',
          'prioridade',
          'toleranciaMinutos',
          'intervaloRepeticaoMinutos',
          'maximoRepeticoes',
          'avisarCuidador',
          'medicamentoDose',
          'medicamentoUnidade',
          'medicamentoEstoque',
          'medicamentoEstoqueMinimo',
          'medicamentoUnidadesPorDose',
          'medicamentoFormato',
          'medicamentoCor',
          'modoConfirmacao',
          'opcoesAdiamentoMinutos',
          'maximoAdiamentos',
          'arquivado',
          'arquivadoEm'
        ]) &&
        data.keys().hasAll([
          'id',
          'titulo',
          'horarioHour',
          'horarioMinute',
          'categoria',
          'idosoId',
          'status',
          'concluido',
          'criadoEm'
        ]) &&
        !changed.hasAny(['id', 'idosoId', 'criadoEm']) &&
        (
          !changed.hasAny(['titulo']) ||
          isNonEmptyString(data.titulo, 200)
        ) &&
        (
          !changed.hasAny(['horarioHour', 'horarioMinute']) ||
          (
            data.horarioHour is int &&
            data.horarioHour >= 0 &&
            data.horarioHour <= 23 &&
            data.horarioMinute is int &&
            data.horarioMinute >= 0 &&
            data.horarioMinute <= 59
          )
        ) &&
        (
          !changed.hasAny(['categoria']) ||
          validCategory(data.categoria)
        ) &&
        (
          !changed.hasAny(['status', 'concluido', 'concluidoComFoto']) ||
          (
            validReminderStatus(st) &&
            data.concluido is bool &&
            data.concluidoComFoto is bool &&
            data.concluido == (st in [
              'concluido',
              'concluido_com_foto',
              'confirmado_pelo_cuidador'
            ]) &&
            data.concluidoComFoto == (st == 'concluido_com_foto')
          )
        ) &&
        (
          !changed.hasAny([
            'prioridade',
            'modoConfirmacao',
            'opcoesAdiamentoMinutos',
            'toleranciaMinutos',
            'intervaloRepeticaoMinutos',
            'maximoRepeticoes',
            'maximoAdiamentos',
            'avisarCuidador',
            'medicamentoFotoPath',
            'status',
            'concluido',
            'concluidoComFoto'
          ]) ||
          validReminderConfig(data)
        ) &&
        (
          !changed.hasAny([
            'originalHorarioHour',
            'originalHorarioMinute',
            'repeteTodosOsDias',
            'recorrenciaSemanal',
            'recorrenciaMensal',
            'recorrenciaIntervalo',
            'lembreteUnico',
            'diasSemana',
            'diaMes',
            'intervaloHoras',
            'recorrencia',
            'dataInicio',
            'dataFim',
            'isUsoContinuo'
          ]) ||
          validReminderSchedule(data)
        ) &&
        (
          !changed.hasAny([
            'medicamentoDose',
            'medicamentoUnidade',
            'medicamentoEstoque',
            'medicamentoEstoqueMinimo',
            'medicamentoUnidadesPorDose',
            'medicamentoInstrucoes',
            'medicamentoAudioTexto',
            'audioPath',
            'medicamentoFotoPath',
            'medicamentoFormato',
            'medicamentoCor'
          ]) ||
          validReminderMedication(data)
        ) &&
        (
          !changed.hasAny(['arquivado', 'arquivadoEm']) ||
          validReminderArchive(data)
        ) &&
        !(
          currentMode in ['foto', 'cuidador'] &&
          changed.hasAny(['modoConfirmacao'])
        ) &&
        !(
          (
            currentMode in ['foto', 'cuidador'] ||
            mode in ['foto', 'cuidador']
          ) &&
          changed.hasAny(['status', 'concluido', 'concluidoComFoto'])
        );
    }

    function validEvent(data) {
      return data.keys().hasOnly([
        'id',
        'lembreteId',
        'titulo',
        'categoria',
        'status',
        'registradoEm',
        'idosoId',
        'observacao',
        'ocorrenciaChave',
        'metodoConfirmacao',
        'corrigeEventoId',
        'atorPapel',
        'estoqueAnterior',
        'unidadesConsumidas',
        'estoqueRestante',
        'estoqueRestaurado',
        'fotoConfirmacaoPath'
      ]) &&
      data.keys().hasAll([
        'id',
        'lembreteId',
        'titulo',
        'categoria',
        'status',
        'registradoEm',
        'idosoId'
      ]) &&
      isNonEmptyString(data.id, 160) &&
      isNonEmptyString(data.lembreteId, 128) &&
      isNonEmptyString(data.titulo, 200) &&
      isNonEmptyString(data.idosoId, 128) &&
      data.categoria is string &&
      validCategory(data.categoria) &&
      data.status is string &&
      validReminderStatus(data.status) &&
      isDate(data.registradoEm) &&
      isOptionalString(data, 'observacao', 500) &&
      isOptionalString(data, 'ocorrenciaChave', 160) &&
      (
        !data.keys().hasAny(['metodoConfirmacao']) ||
        data.metodoConfirmacao in [
          'botao',
          'voz',
          'foto',
          'cuidador',
          'sistema'
        ]
      ) &&
      isOptionalString(data, 'corrigeEventoId', 160) &&
      (
        !data.keys().hasAny(['atorPapel']) ||
        data.atorPapel in ['elderly', 'supervisor', 'system']
      ) &&
      isOptionalInt(data, 'estoqueAnterior', 0, 1000000) &&
      isOptionalNumber(data, 'unidadesConsumidas', 0.01, 10000) &&
      isOptionalInt(data, 'estoqueRestante', 0, 1000000) &&
      isOptionalInt(data, 'estoqueRestaurado', 0, 1000000) &&
      isOptionalString(data, 'fotoConfirmacaoPath', 2048) &&
      (
        !data.keys().hasAny(['fotoConfirmacaoPath']) ||
        data.fotoConfirmacaoPath.matches('^https://.*$')
      );
    }

    function validClientEventAuthority(data) {
      let actorRole = data.get('atorPapel', null);
      let confirmationMethod = data.get('metodoConfirmacao', null);
      return !(data.status in [
        'concluido_com_foto',
        'confirmado_pelo_cuidador'
      ]) &&
      !(confirmationMethod in ['foto', 'cuidador']) &&
      (
        actorRole == null ||
        (
          actorRole == 'elderly' &&
          isOwner(data.idosoId)
        ) ||
        (
          actorRole == 'supervisor' &&
          !isOwner(data.idosoId)
        )
      );
    }

    function validMessageType(value) {
      return value in ['texto', 'audio', 'localizacao'];
    }

    function validSender(elderlyId, senderRole) {
      return (
        isOwner(elderlyId) &&
        senderRole == 'elderly'
      ) || (
        isManagingSupervisor(elderlyId) &&
        senderRole == 'supervisor'
      );
    }

    function validMessage(data) {
      return data.keys().hasOnly([
        'id',
        'idosoId',
        'nomeIdoso',
        'senderRole',
        'tipo',
        'texto',
        'audioPath',
        'criadoEm',
        'lido',
        'duracaoSegundos'
      ]) &&
      data.keys().hasAll([
        'id',
        'idosoId',
        'senderRole',
        'tipo',
        'texto',
        'criadoEm',
        'lido'
      ]) &&
      isNonEmptyString(data.id, 128) &&
      isNonEmptyString(data.idosoId, 128) &&
      isOptionalString(data, 'nomeIdoso', 120) &&
      data.senderRole in ['elderly', 'supervisor'] &&
      data.tipo is string &&
      validMessageType(data.tipo) &&
      data.texto is string &&
      data.texto.size() <= 2000 &&
      isOptionalString(data, 'audioPath', 2048) &&
      isDate(data.criadoEm) &&
      data.lido is bool &&
      isOptionalInt(data, 'duracaoSegundos', 0, 3600) &&
      (
        data.tipo != 'audio' ||
        isNonEmptyString(data.audioPath, 2048)
      ) &&
      (
        data.tipo != 'localizacao' ||
        (
          isNonEmptyString(data.audioPath, 2048) &&
          data.audioPath.matches('^https://.*$')
        )
      );
    }

    function validMessageUpdate() {
      return validMessage(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.idosoId == resource.data.idosoId &&
        request.resource.data.senderRole == resource.data.senderRole &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lido']);
    }

    function validVideoCall(data) {
      return data.keys().hasOnly([
        'roomName',
        'idosoId',
        'supervisorId',
        'status',
        'initiatedBy',
        'callType',
        'startedAt',
        'endedAt',
        'durationSeconds',
        'callerName',
        'seen'
      ]) &&
      data.keys().hasAll([
        'roomName',
        'idosoId',
        'supervisorId',
        'status',
        'initiatedBy',
        'callType',
        'startedAt'
      ]) &&
      isNonEmptyString(data.roomName, 96) &&
      data.roomName.matches('^[A-Za-z0-9_-]+$') &&
      isNonEmptyString(data.idosoId, 128) &&
      isNonEmptyString(data.supervisorId, 128) &&
      data.status in ['ringing', 'connected', 'ended', 'declined', 'missed'] &&
      data.initiatedBy in ['supervisor', 'elderly', 'sos'] &&
      data.callType in ['video', 'voice'] &&
      isDate(data.startedAt) &&
      isOptionalDate(data, 'endedAt') &&
      isOptionalInt(data, 'durationSeconds', 0, 86400) &&
      isOptionalString(data, 'callerName', 120) &&
      isOptionalBool(data, 'seen');
    }

    function validVideoCallCreator(data) {
      return (
        isOwner(data.idosoId) &&
        hasCanonicalProfile(data.idosoId) &&
        canonicalProfile(data.idosoId).status == 'active' &&
        profileHasCaregiver(
          canonicalProfile(data.idosoId),
          data.supervisorId
        ) &&
        data.initiatedBy in ['elderly', 'sos']
      ) || (
        isManagingSupervisor(data.idosoId) &&
        data.supervisorId == request.auth.uid &&
        data.initiatedBy == 'supervisor'
      );
    }

    function validVideoCallTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return validVideoCall(request.resource.data) &&
        request.resource.data.roomName == resource.data.roomName &&
        request.resource.data.idosoId == resource.data.idosoId &&
        request.resource.data.supervisorId == resource.data.supervisorId &&
        request.resource.data.initiatedBy == resource.data.initiatedBy &&
        request.resource.data.callType == resource.data.callType &&
        request.resource.data.startedAt == resource.data.startedAt &&
        changed.hasOnly(['status', 'endedAt', 'durationSeconds', 'seen']) &&
        (
          (
            resource.data.status == 'ringing' &&
            request.resource.data.status in [
              'connected',
              'ended',
              'declined',
              'missed'
            ]
          ) ||
          (
            resource.data.status == 'connected' &&
            request.resource.data.status == 'ended'
          ) ||
          (
            resource.data.status == 'missed' &&
            request.resource.data.status == 'missed' &&
            changed.hasOnly(['seen'])
          )
        );
    }

    function validCaregiverRoleAt(data, index) {
      return data.caregiverIds.size() <= index || (
        isNonEmptyString(data.caregiverIds[index], 128) &&
        data.caregiverRoles.keys().hasAny([data.caregiverIds[index]]) &&
        data.caregiverRoles[data.caregiverIds[index]] in [
          'primary',
          'backup',
          'family',
          'viewer'
        ]
      );
    }

    function validCaregiverNetwork(data) {
      return (
        !data.keys().hasAny(['caregiverIds']) &&
        !data.keys().hasAny(['caregiverRoles'])
      ) || (
        data.caregiverIds is list &&
        data.caregiverIds.size() <= 8 &&
        data.caregiverIds.toSet().size() == data.caregiverIds.size() &&
        data.caregiverRoles is map &&
        data.caregiverRoles.size() <= 8 &&
        data.caregiverRoles.keys().hasOnly(data.caregiverIds) &&
        validCaregiverRoleAt(data, 0) &&
        validCaregiverRoleAt(data, 1) &&
        validCaregiverRoleAt(data, 2) &&
        validCaregiverRoleAt(data, 3) &&
        validCaregiverRoleAt(data, 4) &&
        validCaregiverRoleAt(data, 5) &&
        validCaregiverRoleAt(data, 6) &&
        validCaregiverRoleAt(data, 7) &&
        (
          !data.keys().hasAny(['supervisorId']) ||
          data.supervisorId == null ||
          data.caregiverIds.hasAny([data.supervisorId])
        )
      );
    }

    function validInitialProfile(data) {
      return (
        !data.keys().hasAny(['supervisorId']) ||
        data.supervisorId == null
      ) &&
      (
        !data.keys().hasAny(['status']) ||
        data.status == 'pending'
      ) &&
      (
        !data.keys().hasAny(['caregiverIds']) ||
        (
          data.caregiverIds is list &&
          data.caregiverIds.size() == 0
        )
      ) &&
      (
        !data.keys().hasAny(['caregiverRoles']) ||
        (
          data.caregiverRoles is map &&
          data.caregiverRoles.size() == 0
        )
      ) &&
      (
        !data.keys().hasAny(['pairingCode']) ||
        data.pairingCode == null
      ) &&
      (
        !data.keys().hasAny(['pairingCodeExpires']) ||
        data.pairingCodeExpires == null
      );
    }

    function validProfile(data) {
      return data.keys().hasOnly([
        'nome',
        'idade',
        'telefone',
        'ambulancia_telefone',
        'dataNascimento',
        'endereco',
        'fotoPath',
        'supervisorId',
        'caregiverIds',
        'caregiverRoles',
        'status',
        'pairingCode',
        'pairingCodeExpires',
        'createdAt',
        'updatedAt',
        'lastSeen',
        'alex_voice_rate',
        'alex_voice_pitch',
        'always_listening_enabled'
      ]) &&
      isOptionalString(data, 'nome', 120) &&
      isOptionalInt(data, 'idade', 0, 130) &&
      isOptionalString(data, 'telefone', 30) &&
      isOptionalString(data, 'ambulancia_telefone', 30) &&
      isOptionalString(data, 'dataNascimento', 30) &&
      isOptionalString(data, 'endereco', 300) &&
      isOptionalString(data, 'fotoPath', 2048) &&
      isOptionalNonEmptyString(data, 'supervisorId', 128) &&
      validCaregiverNetwork(data) &&
      (
        !data.keys().hasAny(['status']) ||
        data.status in ['pending', 'active', 'inactive']
      ) &&
      isOptionalString(data, 'pairingCode', 20) &&
      isOptionalDate(data, 'pairingCodeExpires') &&
      isOptionalDate(data, 'createdAt') &&
      isOptionalDate(data, 'updatedAt') &&
      isOptionalDate(data, 'lastSeen') &&
      isOptionalNumber(data, 'alex_voice_rate', 0.1, 1.0) &&
      isOptionalNumber(data, 'alex_voice_pitch', 0.5, 2.0) &&
      isOptionalBool(data, 'always_listening_enabled');
    }

    function validProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'nome',
        'idade',
        'telefone',
        'ambulancia_telefone',
        'dataNascimento',
        'endereco',
        'fotoPath',
        'updatedAt',
        'lastSeen',
        'alex_voice_rate',
        'alex_voice_pitch',
        'always_listening_enabled'
      ]) &&
      isOptionalString(request.resource.data, 'nome', 120) &&
      isOptionalInt(request.resource.data, 'idade', 0, 130) &&
      isOptionalString(request.resource.data, 'telefone', 30) &&
      isOptionalString(request.resource.data, 'ambulancia_telefone', 30) &&
      isOptionalString(request.resource.data, 'dataNascimento', 30) &&
      isOptionalString(request.resource.data, 'endereco', 300) &&
      isOptionalString(request.resource.data, 'fotoPath', 2048) &&
      isOptionalDate(request.resource.data, 'updatedAt') &&
      isOptionalDate(request.resource.data, 'lastSeen') &&
      isOptionalNumber(request.resource.data, 'alex_voice_rate', 0.1, 1.0) &&
      isOptionalNumber(request.resource.data, 'alex_voice_pitch', 0.5, 2.0) &&
      isOptionalBool(request.resource.data, 'always_listening_enabled');
    }

    function validSupervisorProfile(data) {
      return data.keys().hasOnly([
        'nome',
        'email',
        'telefone',
        'fotoPath',
        'criadoEm',
        'createdAt',
        'updatedAt',
        'lastSeen'
      ]) &&
      isOptionalString(data, 'nome', 120) &&
      isOptionalString(data, 'email', 254) &&
      isOptionalString(data, 'telefone', 30) &&
      isOptionalString(data, 'fotoPath', 2048) &&
      isOptionalDate(data, 'criadoEm') &&
      isOptionalDate(data, 'createdAt') &&
      isOptionalDate(data, 'updatedAt') &&
      isOptionalDate(data, 'lastSeen') &&
      (
        !data.keys().hasAny(['email']) ||
        (
          request.auth.token.email is string &&
          request.auth.token.email == data.email
        )
      );
    }

    function validToken(data, role, userId) {
      return data.keys().hasOnly(['token', 'role', 'userId', 'updatedAt']) &&
        data.keys().hasAll(['token', 'role', 'userId', 'updatedAt']) &&
        isNonEmptyString(data.token, 4096) &&
        data.role == role &&
        data.userId == userId &&
        isDate(data.updatedAt);
    }

    function validBarrier(barrier) {
      return barrier is map &&
        barrier.keys().hasOnly([
          'type',
          'severity',
          'title',
          'message',
          'detectedAt',
          'priority',
          'value'
        ]) &&
        barrier.keys().hasAll(['type', 'severity', 'title', 'message', 'detectedAt', 'priority']) &&
        barrier.type in [
          'lowVolume',
          'lowBattery',
          'batteryOptimization',
          'offline',
          'pendingSync',
          'inactiveApp',
          'locationUnavailable'
        ] &&
        barrier.severity in ['info', 'warning', 'critical'] &&
        isNonEmptyString(barrier.title, 120) &&
        isNonEmptyString(barrier.message, 500) &&
        isDate(barrier.detectedAt) &&
        barrier.priority is int &&
        barrier.priority >= 0 &&
        barrier.priority <= 100 &&
        isOptInt(barrier.get('value', null), -1000000, 1000000);
    }

    function validDiagnostics(data) {
      let b = data.barriers;
      return data.keys().hasOnly([
          'barriers',
          'criticalCount',
          'warningCount',
          'batteryLevel',
          'batteryState',
          'lastAlarmTestAt',
          'lastAlarmTestSuccessful',
          'updatedAt'
        ]) &&
        data.keys().hasAll(['barriers', 'updatedAt']) &&
        b is list &&
        b.size() <= 5 &&
        (b.size() <= 0 || validBarrier(b[0])) &&
        (b.size() <= 1 || validBarrier(b[1])) &&
        (b.size() <= 2 || validBarrier(b[2])) &&
        (b.size() <= 3 || validBarrier(b[3])) &&
        (b.size() <= 4 || validBarrier(b[4])) &&
        isOptInt(data.get('criticalCount', null), 0, 5) &&
        isOptInt(data.get('warningCount', null), 0, 5) &&
        isOptInt(data.get('batteryLevel', null), 0, 100) &&
        isOptString(data.get('batteryState', null), 40) &&
        isOptDate(data.get('lastAlarmTestAt', null)) &&
        isOptBool(data.get('lastAlarmTestSuccessful', null)) &&
        isDate(data.updatedAt);
    }

    match /idoso_perfil/{elderlyId} {
      allow get: if canAccessElderly(elderlyId);
      allow list: if isAuth() &&
        resource.data.status == 'active' &&
        resource.data.get('supervisorId', null) == request.auth.uid;
      allow list: if isAuth() &&
        resource.data.status == 'active' &&
        request.auth.uid in resource.data.caregiverIds;
      allow create: if isOwner(elderlyId) &&
        validProfile(request.resource.data) &&
        validInitialProfile(request.resource.data);
      allow update: if canManageElderly(elderlyId) &&
        validProfileUpdate();
      allow delete: if false;
    }

    match /idosos/{elderlyId} {
      allow get: if canAccessElderly(elderlyId);
      allow list: if false;
      allow create: if isOwner(elderlyId) &&
        validProfile(request.resource.data) &&
        validInitialProfile(request.resource.data);
      allow update: if canManageElderly(elderlyId) &&
        validProfileUpdate();
      allow delete: if false;
    }

    match /supervisores/{supervisorId} {
      allow get: if isOwner(supervisorId) ||
        isLinkedElderly(supervisorId);
      allow list: if false;
      allow create, update: if isOwner(supervisorId) &&
        validSupervisorProfile(request.resource.data);
      allow delete: if false;

      match /idosos/{elderlyId} {
        allow read: if isOwner(supervisorId) &&
          isLinkedSupervisor(elderlyId);
        allow write: if false;
      }
    }

    match /lembretes/{reminderId} {
      allow read: if isAuth() &&
        resourceHasElderlyId() &&
        canAccessElderly(resource.data.idosoId);
      allow create: if isAuth() &&
        requestHasElderlyId() &&
        canManageElderly(request.resource.data.idosoId) &&
        validReminder(request.resource.data) &&
        request.resource.data.id == reminderId;
      allow update: if isAuth() &&
        resourceHasElderlyId() &&
        canManageElderly(resource.data.idosoId) &&
        validReminderUpdate();
      allow delete: if false;
    }

    match /lembrete_eventos/{eventId} {
      allow read: if isAuth() &&
        resourceHasElderlyId() &&
        canAccessElderly(resource.data.idosoId);
      allow create: if isAuth() &&
        requestHasElderlyId() &&
        canManageElderly(request.resource.data.idosoId) &&
        validEvent(request.resource.data) &&
        validClientEventAuthority(request.resource.data) &&
        request.resource.data.id == eventId;
      allow update: if false;
      allow delete: if false;
    }

    match /mensagens/{messageId} {
      allow read: if isAuth() &&
        resourceHasElderlyId() &&
        canAccessElderly(resource.data.idosoId);
      allow create: if isAuth() &&
        requestHasElderlyId() &&
        canManageElderly(request.resource.data.idosoId) &&
        validSender(
          request.resource.data.idosoId,
          request.resource.data.senderRole
        ) &&
        validMessage(request.resource.data) &&
        request.resource.data.id == messageId;
      allow update: if isAuth() &&
        resourceHasElderlyId() &&
        canManageElderly(resource.data.idosoId) &&
        validMessageUpdate();
      allow delete: if isAuth() &&
        resourceHasElderlyId() &&
        canManageElderly(resource.data.idosoId);
    }

    match /video_calls/{callId} {
      allow read: if isAuth() &&
        resourceHasElderlyId() &&
        (
          canAccessElderly(resource.data.idosoId) ||
          isOwner(resource.data.supervisorId)
        );
      allow create: if isAuth() &&
        requestHasElderlyId() &&
        validVideoCall(request.resource.data) &&
        validVideoCallCreator(request.resource.data) &&
        request.resource.data.status == 'ringing';
      allow update: if isAuth() &&
        resourceHasElderlyId() &&
        (
          canManageElderly(resource.data.idosoId) ||
          isOwner(resource.data.supervisorId)
        ) &&
        validVideoCallTransition();
      allow delete: if isAuth() &&
        resourceHasElderlyId() &&
        (
          canManageElderly(resource.data.idosoId) ||
          isOwner(resource.data.supervisorId)
        );
    }

    match /health_metrics/{elderlyId} {
      allow read: if canAccessElderly(elderlyId);
      // No current client feature writes this collection. Keep it server-only
      // until a field-level schema is defined for a concrete health feature.
      allow create, update, delete: if false;
    }

    match /device_diagnostics/{elderlyId} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if isOwner(elderlyId) &&
        validDiagnostics(request.resource.data);
      allow delete: if isOwner(elderlyId);
    }

    match /fcm_tokens/{tokenId} {
      allow get: if isAuth() && (
        tokenId == 'elderly_' + request.auth.uid ||
        tokenId == 'supervisor_' + request.auth.uid
      );
      allow list: if false;
      allow create, update: if isAuth() && (
        (
          tokenId == 'elderly_' + request.auth.uid &&
          validToken(
            request.resource.data,
            'elderly',
            request.auth.uid
          )
        ) ||
        (
          tokenId == 'supervisor_' + request.auth.uid &&
          validToken(
            request.resource.data,
            'supervisor',
            request.auth.uid
          )
        )
      );
      allow delete: if isAuth() && (
        tokenId == 'elderly_' + request.auth.uid ||
        tokenId == 'supervisor_' + request.auth.uid
      );
    }

    match /estoque_movimentos/{movementId} {
      allow read: if isAuth() &&
        resourceHasElderlyId() &&
        canAccessElderly(resource.data.idosoId);
      allow create, update, delete: if false;
    }

    match /alertas/{alertId} {
      allow read: if isAuth() &&
        resourceHasElderlyId() &&
        canAccessElderly(resource.data.idosoId);
      allow create, update, delete: if false;
    }

    match /pairing_codes/{document=**} {
      allow read, write: if false;
    }

    match /pairing_state/{document=**} {
      allow read, write: if false;
    }

    match /_rate_limits/{document=**} {
      allow read, write: if false;
    }

    match /medicamentos_barcode/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
