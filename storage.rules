rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function hasCanonicalProfile(elderlyId) {
      return firestore.exists(
        /databases/(default)/documents/idoso_perfil/$(elderlyId)
      );
    }

    function canonicalProfile(elderlyId) {
      return firestore.get(
        /databases/(default)/documents/idoso_perfil/$(elderlyId)
      ).data;
    }

    function profileHasCaregiver(data, caregiverId) {
      return data.get('supervisorId', null) == caregiverId ||
        data.get('caregiverRoles', {}).get(caregiverId, null) in [
          'primary',
          'backup',
          'family',
          'viewer'
        ];
    }

    function hasRelationshipIndex(elderlyId, caregiverId) {
      return firestore.exists(
        /databases/(default)/documents/supervisores/$(caregiverId)/idosos/$(elderlyId)
      );
    }

    function profileCanManage(data, caregiverId) {
      return data.get('supervisorId', null) == caregiverId ||
        data.get('caregiverRoles', {}).get(caregiverId, null) in [
          'primary',
          'backup',
          'family'
        ];
    }

    function relationshipCanManage(elderlyId, caregiverId) {
      return hasRelationshipIndex(elderlyId, caregiverId) &&
        firestore.get(
          /databases/(default)/documents/supervisores/$(caregiverId)/idosos/$(elderlyId)
        ).data.get('role', null) in ['primary', 'backup', 'family'];
    }

    function isLinkedSupervisor(elderlyId) {
      return isAuth() &&
        hasCanonicalProfile(elderlyId) &&
        canonicalProfile(elderlyId).status == 'active' &&
        (
          profileHasCaregiver(
            canonicalProfile(elderlyId),
            request.auth.uid
          ) ||
          hasRelationshipIndex(elderlyId, request.auth.uid)
        );
    }

    function isManagingSupervisor(elderlyId) {
      return isAuth() &&
        hasCanonicalProfile(elderlyId) &&
        canonicalProfile(elderlyId).status == 'active' &&
        (
          profileCanManage(
            canonicalProfile(elderlyId),
            request.auth.uid
          ) ||
          relationshipCanManage(elderlyId, request.auth.uid)
        );
    }

    function isLinkedElderly(supervisorId) {
      return isAuth() &&
        hasCanonicalProfile(request.auth.uid) &&
        canonicalProfile(request.auth.uid).status == 'active' &&
        profileHasCaregiver(
          canonicalProfile(request.auth.uid),
          supervisorId
        );
    }

    function canAccessElderly(elderlyId) {
      return isOwner(elderlyId) || isLinkedSupervisor(elderlyId);
    }

    function canManageElderly(elderlyId) {
      return isOwner(elderlyId) || isManagingSupervisor(elderlyId);
    }

    function validAudio(fileName, maxBytes) {
      return fileName.matches(
          '^[A-Za-z0-9_-]{1,128}\\.(mp3|wav|m4a|ogg|aac)$'
        ) &&
        request.resource.size > 0 &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches(
          '^audio/(mpeg|mp4|wav|ogg|aac|x-m4a)$'
        );
    }

    function validImage(fileName, maxBytes) {
      return fileName.matches(
          '^[A-Za-z0-9_-]{1,128}\\.(jpg|jpeg|png|webp)$'
        ) &&
        request.resource.size > 0 &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches(
          '^image/(jpeg|png|webp)$'
        );
    }

    match /reminder_audio/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canManageElderly(elderlyId) &&
        validAudio(fileName, 10 * 1024 * 1024);
      allow delete: if canManageElderly(elderlyId);
    }

    match /reminder_photos/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canManageElderly(elderlyId) &&
        validImage(fileName, 5 * 1024 * 1024);
      allow delete: if canManageElderly(elderlyId);
    }

    match /confirmation_photos/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canManageElderly(elderlyId) &&
        validImage(fileName, 5 * 1024 * 1024);
      allow delete: if canManageElderly(elderlyId);
    }

    match /message_audio/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canManageElderly(elderlyId) &&
        validAudio(fileName, 10 * 1024 * 1024);
      allow delete: if canManageElderly(elderlyId);
    }

    match /perfis/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canManageElderly(elderlyId) &&
        validImage(fileName, 5 * 1024 * 1024);
      allow delete: if canManageElderly(elderlyId);
    }

    match /perfis_supervisor/{supervisorId}/{fileName} {
      allow read: if isOwner(supervisorId) ||
        isLinkedElderly(supervisorId);
      allow create, update: if isOwner(supervisorId) &&
        validImage(fileName, 5 * 1024 * 1024);
      allow delete: if isOwner(supervisorId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
