rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function hasCanonicalProfile(elderlyId) {
      return firestore.exists(
        /databases/(default)/documents/idoso_perfil/$(elderlyId)
      );
    }

    function canonicalProfile(elderlyId) {
      return firestore.get(
        /databases/(default)/documents/idoso_perfil/$(elderlyId)
      ).data;
    }

    function isLinkedSupervisor(elderlyId) {
      return isAuth() &&
        hasCanonicalProfile(elderlyId) &&
        canonicalProfile(elderlyId).status == 'active' &&
        canonicalProfile(elderlyId).supervisorId == request.auth.uid;
    }

    function isLinkedElderly(supervisorId) {
      return isAuth() &&
        hasCanonicalProfile(request.auth.uid) &&
        canonicalProfile(request.auth.uid).status == 'active' &&
        canonicalProfile(request.auth.uid).supervisorId == supervisorId;
    }

    function canAccessElderly(elderlyId) {
      return isOwner(elderlyId) || isLinkedSupervisor(elderlyId);
    }

    function validAudio(fileName, maxBytes) {
      return fileName.matches(
          '^[A-Za-z0-9_-]{1,128}\\.(mp3|wav|m4a|ogg|aac)$'
        ) &&
        request.resource.size > 0 &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches(
          '^audio/(mpeg|mp4|wav|ogg|aac|x-m4a)$'
        );
    }

    function validImage(fileName, maxBytes) {
      return fileName.matches(
          '^[A-Za-z0-9_-]{1,128}\\.(jpg|jpeg|png|webp)$'
        ) &&
        request.resource.size > 0 &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches(
          '^image/(jpeg|png|webp)$'
        );
    }

    match /reminder_audio/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canAccessElderly(elderlyId) &&
        validAudio(fileName, 10 * 1024 * 1024);
      allow delete: if canAccessElderly(elderlyId);
    }

    match /reminder_photos/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canAccessElderly(elderlyId) &&
        validImage(fileName, 5 * 1024 * 1024);
      allow delete: if canAccessElderly(elderlyId);
    }

    match /confirmation_photos/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canAccessElderly(elderlyId) &&
        validImage(fileName, 5 * 1024 * 1024);
      allow delete: if canAccessElderly(elderlyId);
    }

    match /message_audio/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canAccessElderly(elderlyId) &&
        validAudio(fileName, 10 * 1024 * 1024);
      allow delete: if canAccessElderly(elderlyId);
    }

    match /perfis/{elderlyId}/{fileName} {
      allow read: if canAccessElderly(elderlyId);
      allow create, update: if canAccessElderly(elderlyId) &&
        validImage(fileName, 5 * 1024 * 1024);
      allow delete: if canAccessElderly(elderlyId);
    }

    match /perfis_supervisor/{supervisorId}/{fileName} {
      allow read: if isOwner(supervisorId) ||
        isLinkedElderly(supervisorId);
      allow create, update: if isOwner(supervisorId) &&
        validImage(fileName, 5 * 1024 * 1024);
      allow delete: if isOwner(supervisorId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
